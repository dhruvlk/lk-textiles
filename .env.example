# ─────────────────────────────────────────────────────────────────────────
# Environment variables read by the app. Copy to .env.local and fill in.
# Never commit real values. Variables without NEXT_PUBLIC_ are server-only.
# ─────────────────────────────────────────────────────────────────────────

# Supabase (required)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-or-publishable-key>
# Server-only. Used by /api/employees, /api/contact and landing uploads.
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# Public site URL (used for auth redirects, metadata, sitemap)
NEXT_PUBLIC_APP_URL=https://your-domain.example

# Landing-page admin (/admin landing editor). Login is DISABLED unless all
# three are set; the secret must be at least 32 random characters
# (e.g. `openssl rand -base64 48`).
LANDING_ADMIN_EMAIL=admin@your-domain.example
LANDING_ADMIN_PASSWORD=<strong-unique-password>
LANDING_ADMIN_SECRET=<32+ random characters>

# SMTP for contact-form emails
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=no-reply@your-domain.example
SMTP_PASS=<smtp-password>
# Optional: where contact-form notifications go (defaults to SMTP_USER)
ADMIN_EMAIL=

# ─────────────────────────────────────────────────────────────────────────
# Planned integrations (not read by the current code yet)
# ─────────────────────────────────────────────────────────────────────────
# GST API (server-side only — never expose keys to the browser)

# Provider: mock | appyflow | http
# GST_API_PROVIDER=mock

# AppyFlow: https://appyflow.in/
# GST_API_PROVIDER=appyflow
# GST_API_KEY=your_appyflow_api_key

# Generic HTTP provider
# GST_API_PROVIDER=http
# GST_API_BASE_URL=https://your-provider.example.com/gst
# GST_API_KEY=your_api_key
# GST_API_KEY_HEADER=Authorization
# GST_API_PATH_TEMPLATE=/{gstin}
# GST_API_METHOD=GET

# WhatsApp Integration (server-side only — never expose to browser)
# Provider: 'web' (default, manual/wa.me dispatch) | 'cloud_api' (Meta WhatsApp Cloud API)
# WHATSAPP_PROVIDER=web

# Meta WhatsApp Business Cloud API credentials (required only when WHATSAPP_PROVIDER=cloud_api)
# WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
# WHATSAPP_ACCESS_TOKEN=your_permanent_or_system_user_access_token
# WHATSAPP_BUSINESS_ACCOUNT_ID=your_business_account_id

